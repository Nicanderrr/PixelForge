APP_NAME=Forma
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8030
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=forma
DB_USERNAME=forma
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=forma_
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Paste your dedicated LOCAL development API key below. Never use VITE_ for secrets.
PIXELFORGE_API_KEY=
# Copy this key's signing secret from its PixelForge dashboard webhook settings.
PIXELFORGE_WEBHOOK_SECRET=
PIXELFORGE_BASE_URL=https://pixelforge.promptedit.dev/v1
PIXELFORGE_ACCOUNT_SCOPE=forma-local
# Dashboard webhook URL: https://YOUR-PUBLIC-TUNNEL/webhooks/pixelforge
# Localhost webhook URLs are rejected by PixelForge. Polling works without a tunnel.
