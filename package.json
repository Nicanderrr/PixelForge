    "format:check": "prettier --check resources/js resources/css tests/Browser"
  },
  "dependencies": {
    "@inertiajs/vue3": "^2.0",
    "@lucide/vue": "^1.78.0",
    "vue": "^3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.0",
    "@vitejs/plugin-vue": "^6.0",
    "concurrently": "^10.0.7",
    "laravel-vite-plugin": "^2.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.0",
    "typescript": "^5.9",
    "vite": "^7.0",
    "vue-tsc": "^3.0"
  }
}
